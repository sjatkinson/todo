#!/usr/bin/env sh

usage() {
    echo "todo - a tool to display todo lists"
    echo ""
    echo "Usage:"
    echo "     todo -[hlsecd] [arg]"
    echo "         -h display this help screen"
    echo "         -f [list] full display"
    echo "         -e [list] edits the todo list"
}

DATA_HOME="${XDG_DATA_HOME:=~/.local/share}/todos"
mkdir -p $DATA_HOME
display_opt=compact
cmd=display
while getopts ":hlsem" opt; do
    case ${opt} in
        h ) cmd=help
            ;;
        e ) cmd=edit
            ;;
        \? )
            echo "Invalid option: $OPTARG" 1>&2
            usage
            exit 1
            ;;
    esac
done
shift $((OPTIND -1))

if [ $1 ] ; then
    kind=$1
else
    kind=current
fi

todo_file=$DATA_HOME"/"$kind".todos"
if [ ! -f $todo_file ] ; then
    if [ "$cmd" = "display" ] ; then
        echo "$1 does not exist."
        echo "Run '$ todo -e $1' to create and edit it."
        exit -1
    fi
fi

case ${cmd} in
    help )
        usage
        ;;
    edit )
        $EDITOR $todo_file
        ;;
    display )
        cat $todo_file
        ;;
esac
